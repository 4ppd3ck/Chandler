#: <<'END_COMMENT'
PROMPT_COMMAND=__prompt_command

__prompt_command() {
    local EXIT="$?"

    # Load color variables
    local RED='\[\033[0;31m\]'
    local GREEN='\[\033[0;32m\]'
    local YELLOW='\[\033[0;33m\]'
    local RESET='\[\033[0m\]'

    # Build the prompt
    PS1="${RED}pwd${RESET}:${GREEN}\w${RESET} "
    PS1+="$(kubectl_prompt_info) "
    PS1+="$(git_branch_info) "
    if [ -n "$sso_selected_profile" ]; then
        PS1+="${RED}sso_profile${RESET}:${GREEN}$SSO_CURRENT_PROFILE${RESET} "
    fi
    if [[ -n $AWS_CURRENT_PROFILE ]]; then
        PS1+="${RED}aws${RESET}:${GREEN}$AWS_CURRENT_PROFILE${RESET} "
    fi
    PS1+="\n\$ "
}
#END_COMMENT