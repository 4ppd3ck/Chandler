 # .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ $PATH =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi

unset rc

# Generated for envman. Do not edit.
[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"
[ -f "$HOME/.bash_environment" ] && source "$HOME/.bash_environment"
[ -f "$HOME/.bash_function" ] && source "$HOME/.bash_function"
[ -f "$HOME/.aws_environment" ] && source "$HOME/.aws_environment"
[ -f "$HOME/.commands_environment" ] && source "$HOME/.commands_environment"

