RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RESET='\033[0m'

shopt -s expand_aliases

function kubectl_prompt_info() {
    local ctx=$(kubectx -c 2> /dev/null)
    local ns=$(kubens -c 2> /dev/null)
    echo -e "${RED}${ctx}${RESET}:${GREEN}${ns}${RESET}"
}

function git_branch_info() {
    local branch=$(git rev-parse --abbrev-ref HEAD 2> /dev/null)
    if [ -n "$branch" ]; then
        echo -e "${YELLOW}git:${branch}${RESET}"
    fi
}

# ------------------------------------------------------------------
# Usage: PICKED=$(candidates | __tui_pick "Title" "prompt> ")
# Uses ~/.local/share/chandler/scripts/misc/tui_select.sh; falls back to a numbered
# prompt drawn on /dev/tty when that helper is not installed. Cancelling,
# EOF or a bad answer all return empty — nothing is emitted on failure.
# ------------------------------------------------------------------
__tui_pick() {
    local title="$1" prompt="$2"
    local list tui out rc=0 pick sel
    list=$(cat)
    tui="$HOME/.local/share/chandler/scripts/misc/tui_select.sh"
    if [[ -f "$tui" ]]; then
        out=$(printf '%s\n' "$list" | bash "$tui" --title "$title" --prompt "$prompt") || rc=$?
        if (( rc == 0 )); then printf '%s' "$out"; return 0; fi
        (( rc == 1 )) && return 1
    fi
    # Helper not installed: numbered prompt, drawn straight on the terminal.
    if ! { exec 8<>/dev/tty; } 2>/dev/null; then
        return 1
    fi
    if [[ -n "$list" ]]; then
        printf '%s\n' "$list" | nl -ba >&8
    fi
    printf '#: ' >&8
    IFS= read -r pick <&8 || { exec 8>&- 8<&-; return 1; }
    exec 8>&- 8<&-
    [[ "$pick" =~ ^[0-9]+$ ]] || return 1
    sel=$(printf '%s\n' "$list" | sed -n "${pick}p")
    [[ -n "$sel" ]] && printf '%s' "$sel"
}

function kctx() {
    #k8screds
    local context
    context=$(kubectx | __tui_pick "Select Kubernetes Context" "ctx> ")
    if [ -n "$context" ]; then
        kubectx "$context"
    fi
}

function kens() {
    local namespace
    namespace=$(kubens | __tui_pick "Select Kubernetes Namespace" "ns> ")
    if [ -n "$namespace" ]; then
        kubens "$namespace"
    fi
}

k8s_version() {
  KUBECTL_VERSIONS_DIR="$HOME/.local/bin/kubectl-versions"
  KUBECTL_BIN="$HOME/.local/bin/kubectl"

  SELECTED_VERSION=$(ls "$KUBECTL_VERSIONS_DIR" | __tui_pick "Select Kubernetes Version" "ver> ")
  [ -z "$SELECTED_VERSION" ] && { echo "No version selected."; return 1; }
  echo "Creating symlink: $KUBECTL_BIN -> $KUBECTL_VERSIONS_DIR/$SELECTED_VERSION"
  ln -sf "$KUBECTL_VERSIONS_DIR/$SELECTED_VERSION" "$KUBECTL_BIN"
}

tf_version() {
  TERRAFORM_VERSIONS_DIR="$HOME/.local/bin/terraform-versions"
  TERRAFORM_BIN="$HOME/.local/bin/terraform"

  SELECTED_VERSION=$(ls "$TERRAFORM_VERSIONS_DIR" | __tui_pick "Select Terraform Version" "ver> ")
  [ -z "$SELECTED_VERSION" ] && { echo "No version selected."; return 1; }
  echo "Creating symlink: $TERRAFORM_BIN -> $TERRAFORM_VERSIONS_DIR/$SELECTED_VERSION"
  ln -sf "$TERRAFORM_VERSIONS_DIR/$SELECTED_VERSION" "$TERRAFORM_BIN"
}


aws_profile() {
    creds_dir="$HOME/awsconfig"

    select_profile=$(ls "$creds_dir"/*.txt 2>/dev/null | xargs -n 1 basename | sed 's/.txt$//' | __tui_pick "Select AWS Profile" "profile> ")

    if [[ -z "$select_profile" ]]; then
        echo "No profile selected, Exiting..."
        return 1
    fi

    AWS_CURRENT_PROFILE=$(basename "$select_profile" .txt)

    echo "[default]" > "$HOME/.aws/credentials"

    tail -n +2 "$creds_dir/$select_profile.txt" >> "$HOME/.aws/credentials"

    chmod 600 "$HOME/.aws/credentials"
    echo "Copied keys to [default]."
    echo "Current AWS profile: $AWS_CURRENT_PROFILE"
}

function sso_login() {
    selected_profile=$(aws configure list-profiles | __tui_pick "Select AWS SSO Profile to login" "login> ")
    if [ -n "$selected_profile" ]; then
        echo "Logging into AWS SSO Profile: $selected_profile"
        aws sso login --profile "$selected_profile"
    else
        echo "No Profile Selected..."
    fi
}

function sso_profile() {
    sso_selected_profile=$(aws configure list-profiles | __tui_pick "Select Default AWS SSO Profile" "profile> ")
    if [ -n "$sso_selected_profile" ]; then
        echo "Setting $sso_selected_profile as AWS DEFAULT SSO Profile"
        export AWS_PROFILE="$sso_selected_profile"
        SSO_CURRENT_PROFILE=${sso_selected_profile}
    else
        echo "No Profile Selected..."
    fi
}

ssm_session() {
    if [ -z "$1" ]; then
        echo "Usage: ssm_session <instance-name> [profile] [region]"
        return 1
    fi

    local instance_name="$1"
    local profile_name="${2:-default}"
    local region_name="${3:-us-east-1}"

    export AWS_PROFILE="$profile_name"

    echo "Getting instance-id for '$instance_name'..."
    instance_id=$(aws ec2 describe-instances \
        --filters "Name=tag:Name,Values=$instance_name" \
        --query "Reservations[].Instances[].InstanceId" \
        --profile "$profile_name" \
        --region "$region_name" \
        --output text)

    if [ -z "$instance_id" ]; then
        echo "Error: Instance '$instance_name' not found in profile '$profile_name' in region '$region_name'."
        return 1
    fi

    echo "Getting instance '$instance_name' status..."
    instance_status=$(aws ec2 describe-instances \
        --instance-ids "$instance_id" \
        --region "$region_name" \
        --query "Reservations[].Instances[].State.Name" \
        --output text)
    if [ "$instance_status" == "running" ]; then
        echo "Instance is running, connecting to instance '$instance_name'..."
        local doc_args=()
        if [ -n "${SSM_DOCUMENT:-}" ]; then
            echo "Using SSM Document: $SSM_DOCUMENT"
            doc_args=(--document-name "$SSM_DOCUMENT")
        fi
        aws ssm start-session \
            --target "$instance_id" \
            ${doc_args[@]+"${doc_args[@]}"} \
            --profile "$profile_name" \
            --region "$region_name"
    elif [ "$instance_status" == "stopped" ]; then
        echo "Instance '$instance_name' is stopped..."
    else
        echo "Unable to get instance status..."
    fi
}
